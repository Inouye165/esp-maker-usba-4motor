# Environment variables configuration template for the Rover ESP32 build
# Copy to .env and replace placeholders with actual values (do not commit .env)

# RPi 5 Network Configuration
ROVER_PI_HOST=rover
ROVER_PI_USER=ron
ROVER_PI_PORT=22
ROVER_PI_APP_DIR=/home/ron/yahboom-encoder

# Target Device Configurations
ROVER_ESP32_DEVICE=/dev/rover-esp32
ROVER_LIDAR_DEVICE=/dev/rover-lidar

# Authentication method (SSH Agent or Private key path)
# e.g. C:/Users/Ron/.ssh/id_rsa
ROVER_PI_SSH_KEY=
